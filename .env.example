# =====================================================================
# HostAI Concierge — copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real keys.
# =====================================================================

# --- Supabase -------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key: BYPASSES Row Level Security. Server-side only.
# Never prefix it with NEXT_PUBLIC_ and never import it into a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Anthropic (Phase 4) --------------------------------------------
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Chat + vision model. claude-sonnet-5 is the cost/quality pick for this
# workload; swap to claude-opus-5 if you want maximum reasoning quality.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe ---------------------------------------------------------
# Nothing to set here. Payment Links live in each HOST's own Stripe account,
# and each host pastes their own webhook signing secret into
# /dashboard/settings. This app never holds Stripe credentials.

# --- App ------------------------------------------------------------
# Used to build QR code target URLs and OAuth redirects.
# Local: http://localhost:3000   Prod: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
