# =====================================================================
# Mouravi (მოურავი) — copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real keys.
# =====================================================================

# --- Supabase -------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key: BYPASSES Row Level Security. Server-side only.
# Never prefix it with NEXT_PUBLIC_ and never import it into a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Gemini ---------------------------------------------------------
# aistudio.google.com -> Get API key. Free tier needs no card.
GEMINI_API_KEY=AQ....
# Chat + vision model. Thinking is forced to "minimal" in reply.ts — the
# default (medium) spent ~320 thinking tokens answering "what's the wifi
# password", and a guest is staring at a typing indicator.
GEMINI_MODEL=gemini-3.6-flash

# --- Payments -------------------------------------------------------
# Nothing to set here. Payment links live in each HOST's own account —
# Bank of Georgia, TBC, unipay, or Stripe for the few hosts who have it.
# Stripe hosts paste their own webhook signing secret into
# /dashboard/settings. This app never holds payment credentials.

# --- App ------------------------------------------------------------
# Used to build QR code target URLs and OAuth redirects.
# Local: http://localhost:3000   Prod: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Guards /api/cron/cleanup-uploads, which deletes old guest photos. Any long
# random string; the scheduler sends it as `Authorization: Bearer <value>`.
CRON_SECRET=
# Days a guest photo is kept before deletion. Defaults to 30 when unset.
# This is what decides how long Supabase's 1 GB free tier lasts.
UPLOAD_RETENTION_DAYS=30
